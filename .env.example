# Plantilla de configuración de FinApp.
# Copia este archivo a .env y completa los valores. NUNCA versiones el archivo .env.

# MODELOS DE IA
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# BUSQUEDAS
TAVILY_API_KEY=

# ORIGENES PERMITIDOS PARA EL FRONTEND
# Se comparan sin distinguir mayúsculas, pero conviene escribirlos en minúsculas.
WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_APP_URL=http://localhost:5173

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=

# JWT (Base64 de al menos 256 bits). Genera una con:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
FINAPP_JWT_SECRET=
FINAPP_JWT_EXPIRATION_SECONDS=28800
FINAPP_JWT_INACTIVITY_SECONDS=1800
# Cookie de sesión: Secure (obligatorio en HTTPS) y SameSite.
# "Lax" si la web y la API comparten sitio; "None" si la web está en otro dominio.
FINAPP_JWT_COOKIE_SECURE=true
FINAPP_JWT_COOKIE_SAME_SITE=Lax

# SESIÓN (access + refresh deslizante). Los cuatro tiempos viven en SesionConfig.
FINAPP_SESION_ACCESS_SECONDS=900
FINAPP_SESION_REFRESH_INACTIVITY_SECONDS=1800
FINAPP_SESION_ABSOLUTE_SECONDS=28800
FINAPP_SESION_REUSE_GRACE_SECONDS=15
FINAPP_SESION_LIMPIEZA_INTERVALO_MS=3600000
# Solo estos peers pueden aportar CF-Connecting-IP / X-Forwarded-For / X-Real-IP.
# cloudflared en el mismo host conecta desde 127.0.0.1; no añadas la IP pública del usuario.
FINAPP_PROXIES_CONFIABLES=127.0.0.1/32,::1/128

# CIFRADO DE ALMACENAMIENTO EXTERNO
FINAPP_ALMACENAMIENTO_CIPHER_SECRET=

# LOGIN DE USUARIO SWAGGER (acceso administrativo).
# LOGIN_USER: alias del operador administrativo que se escribe en Swagger.
# LOGIN_PASSWORD: secreto compartido del acceso administrativo.
# FINAPP_ADMIN_USER_ID: id_usuario de la cuenta que representa la sesión administrativa.
# Deja LOGIN_USER o LOGIN_PASSWORD vacíos para desactivar el acceso administrativo.
LOGIN_USER=
LOGIN_PASSWORD=
FINAPP_ADMIN_USER_ID=

# TELEGRAM BOT
TELEGRAM_BOT_TOKEN=
NOMBRE_BOT_TELEGRAM=
ID_USER_TELEGRAM=
FIRST_NAME_USER_TELEGRAM=
   

# TRM
FINAPP_TRM_URL=h

# ALMACENAMIENTO (cifrado propio de conexiones)
FINAPP_ALMACENAMIENTO_CIPHER_SECRET=

